# BitsyBot environment variables — copy to .env and fill in your values

# Operating mode: paper | live | backtest
BITSYBOT_MODE=paper

# Bitso API credentials (required for live mode and private endpoints)
BITSO_API_KEY=your_api_key_here
BITSO_API_SECRET=your_api_secret_here

# Grid parameters
BITSYBOT_BOOK=btc_mxn
BITSYBOT_GRID_LOWER=800000
BITSYBOT_GRID_UPPER=1200000
BITSYBOT_GRID_LEVELS=10
BITSYBOT_INVESTMENT_MXN=5000

# Paper trading
BITSYBOT_PAPER_BALANCE=10000
BITSYBOT_POLL_INTERVAL=10

# Backtest
BITSYBOT_BACKTEST_DAYS=365
BITSYBOT_TIME_BUCKET=1d

# Dashboard
BITSYBOT_DASHBOARD_PORT=8501
BITSYBOT_DASHBOARD_REFRESH=30

# Telegram notifications (optional — leave blank to disable)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
